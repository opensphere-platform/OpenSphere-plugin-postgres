{
  "manifestVersion": 3,
  "kind": "plugin",
  "id": "postgres",
  "hostRef": "foundation",
  "hostApiVersion": "1.0.0",
  "hostCompat": ">=1.0.0 <2.0.0",
  "version": "0.1.1",
  "title": "PostgreSQL",
  "description": "StackGres 기반 PostgreSQL Fleet 관리와 pgAdmin 운영 화면.",
  "entry": "main.js",
  "entrySha256": "eeeb510565c67b6325705ff1c91d3bb5b3fd080bbab1a684b85ddfd960a1f7a2",
  "shellCompat": ">=0.2.0 <0.9.0",
  "sdkVersion": "0.3.6",
  "apiBase": "/api/plugins/postgres",
  "permissions": [
    "api:proxy",
    "manual:contribute"
  ],
  "nav": {
    "band": "운영 Operate",
    "label": "PostgreSQL"
  },
  "designSystem": "clarity",
  "renderMode": "esm",
  "contributions": {
    "page": {
      "enabled": false,
      "reason": "Mounted inside the Foundation subShell"
    },
    "navigation": {
      "enabled": false,
      "mode": "none",
      "reason": "Foundation owns child navigation"
    },
    "api": {
      "enabled": false,
      "reason": "Governed PostgreSQL writes remain on the Foundation host API"
    },
    "cli": {
      "enabled": true,
      "namespace": "postgres",
      "manifestPath": "/cli/manifest"
    },
    "manual": {
      "enabled": true,
      "sourceId": "plugin:postgres",
      "mode": "runtime"
    },
    "search": {
      "enabled": true,
      "mode": "index"
    },
    "notification": {
      "enabled": false,
      "frontend": false,
      "backend": false,
      "reason": "No notification producer"
    },
    "observability": {
      "enabled": true,
      "logs": true,
      "metrics": true,
      "traces": false,
      "reason": "Runtime health and load metrics only"
    }
  }
}
